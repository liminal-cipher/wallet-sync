{
  "expo": {
    "name": "wallet-sync",
    "slug": "wallet-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.liminalcipher.walletsync",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-build-properties", { "ios": { "deploymentTarget": "15.5" } }],
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": [
            "latin",
            "korean"
          ],
          "ocrUseBundled": true
        }
      ],
      "./plugins/withKoreanOcr",
      [
        "expo-camera",
        {
          "cameraPermission": "쿠폰 바코드를 스캔하려면 카메라 접근이 필요합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "쿠폰 원본 이미지를 선택하려면 사진 접근이 필요합니다.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "213483bd-04bc-4256-977a-4300d56de94a"
      }
    },
    "owner": "liminal-cipher"
  }
}
