{
  "name": "wallet-sync",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "check:catalogue": "jest --runInBand tests/brandCatalogue.test.js",
    "check:android": "node scripts/check-android-build.cjs",
    "build:android:preview": "npm run check:android && npx eas-cli@25.2.0 build --platform android --profile preview",
    "eas-build-post-install": "node scripts/check-android-build.cjs",
    "test:rules": "npx --yes --package=firebase-tools@15.34.0 -- firebase emulators:exec --only firestore,storage --project demo-wallet-sync-rules --config firebase.emulator.json \"jest --runInBand tests/firestore.rules.test.js tests/storage.rules.test.js\"",
    "test:integration": "npx --yes --package=firebase-tools@15.34.0 -- firebase emulators:exec --only firestore,storage --project demo-wallet-sync-rules --config firebase.emulator.json \"jest --runInBand\""
  },
  "dependencies": {
    "@bwip-js/generic": "4.11.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "expo": "~55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-image-picker": "~55.0.24",
    "expo-notifications": "~55.0.27",
    "expo-print": "~55.0.19",
    "expo-sharing": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "firebase": "^12.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "rn-mlkit-ocr": "0.3.1",
    "tesseract.js": "7.0.0"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.27.1",
    "@babel/plugin-transform-react-jsx": "7.27.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "babel-jest": "29.7.0",
    "jest": "~29.7.0",
    "react-test-renderer": "19.2.0"
  },
