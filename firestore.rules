rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/couponKeys/{key} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /coupons/{couponId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      // Removal is reversible; clients cannot permanently erase recovery history.
      allow delete: if false;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.revision == resource.data.get('revision', 0) + 1
                    && getAfter(/databases/$(database)/documents/coupons/$(couponId)/history/$(string(resource.data.get('revision', 0)))).data.record == resource.data;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      match /history/{version} {
        allow read: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/coupons/$(couponId)).data.userId;
        allow create: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/coupons/$(couponId)).data.userId
                      && request.resource.data.userId == request.auth.uid
                      && version == string(get(/databases/$(database)/documents/coupons/$(couponId)).data.get('revision', 0))
                      && request.resource.data.record == get(/databases/$(database)/documents/coupons/$(couponId)).data
                      && getAfter(/databases/$(database)/documents/coupons/$(couponId)).data.revision == get(/databases/$(database)/documents/coupons/$(couponId)).data.get('revision', 0) + 1;
        allow update, delete: if false;
      }
    }
  }
}
