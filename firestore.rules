rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(walletId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/wallets/$(walletId)).data.memberIds;
    }
    function validWallet(data) {
      return data.keys().hasOnly(['name', 'ownerId', 'memberIds', 'inviteHash', 'createdAt', 'updatedAt'])
             && data.name is string && data.name.size() > 0 && data.name.size() <= 60
             && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 2
             && data.memberIds[0] == data.ownerId
             && data.memberIds.toSet().size() == data.memberIds.size()
             && data.createdAt is timestamp && data.updatedAt is timestamp
             && (data.inviteHash == null || (data.inviteHash is string && data.inviteHash.matches('^[a-f0-9]{64}$')));
    }
    function validSharedImage(data, walletId) {
      return data.get('image', null) == null || (data.image is map && data.image.walletId == walletId && data.image.get('cloudPath', null) == null);
    }
    match /users/{userId}/settings/sharedWallet {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['walletId'])
                            && userId in getAfter(/databases/$(database)/documents/wallets/$(request.resource.data.walletId)).data.memberIds;
    }
    function validDriveFolder(data) {
      return data.keys().hasOnly(['version', 'folderId', 'ownerPermissionId', 'createdBy', 'createdAt'])
             && data.version == 1 && data.folderId is string && data.folderId.matches('^[A-Za-z0-9_-]{10,200}$')
             && data.ownerPermissionId is string && data.ownerPermissionId.matches('^[0-9]{1,100}$')
             && data.createdBy == request.auth.uid && data.createdAt is timestamp;
    }
    match /users/{userId}/settings/drive {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && validDriveFolder(request.resource.data);
      allow update, delete: if false;
    }
    match /wallets/{walletId} {
      allow read: if member(walletId);
      allow create: if signedIn() && validWallet(request.resource.data)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid]
                    && request.resource.data.inviteHash == null;
      function joining() {
        let invitation = get(/databases/$(database)/documents/walletInvites/$(resource.data.inviteHash)).data;
        return resource.data.memberIds.size() == 1
               && invitation.walletId == walletId && invitation.ownerId == resource.data.ownerId
               && invitation.acceptedBy == null && invitation.expiresAt > request.time
               && request.auth.uid != resource.data.ownerId
               && getAfter(/databases/$(database)/documents/walletInvites/$(resource.data.inviteHash)).data.acceptedBy == request.auth.uid
               && request.resource.data.memberIds == [resource.data.ownerId, request.auth.uid]
               && request.resource.data.inviteHash == null
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'inviteHash', 'updatedAt']);
      }
      allow update: if signedIn() && validWallet(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (
                      (request.auth.uid == resource.data.ownerId
                       && request.resource.data.memberIds.hasOnly(resource.data.memberIds))
                      || (request.auth.uid in resource.data.memberIds
                          && request.auth.uid != resource.data.ownerId
                          && request.resource.data.memberIds == [resource.data.ownerId]
                          && request.resource.data.inviteHash == null
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'inviteHash', 'updatedAt']))
                      || joining()
                    );
      allow delete: if false;
      match /settings/drive {
        allow read: if member(walletId);
        allow create: if member(walletId)
                      && get(/databases/$(database)/documents/wallets/$(walletId)).data.ownerId == request.auth.uid
                      && validDriveFolder(request.resource.data);
        allow update, delete: if false;
      }
      match /couponKeys/{key} {
        allow read, write: if member(walletId);
      }
      match /coupons/{couponId} {
        allow read: if member(walletId);
        allow create: if member(walletId) && request.resource.data.walletId == walletId
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.updatedBy == request.auth.uid
                      && request.resource.data.revision == 1
                      && validSharedImage(request.resource.data, walletId);
        allow update: if member(walletId)
                      && request.resource.data.walletId == walletId
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.updatedBy == request.auth.uid
                      && validSharedImage(request.resource.data, walletId)
                      && request.resource.data.revision == resource.data.revision + 1
                      && getAfter(/databases/$(database)/documents/wallets/$(walletId)/coupons/$(couponId)/history/$(string(resource.data.revision))).data.record == resource.data;
        allow delete: if false;
        match /history/{version} {
          allow read: if member(walletId);
          allow create: if member(walletId)
                        && request.resource.data.userId == request.auth.uid
                        && version == string(get(/databases/$(database)/documents/wallets/$(walletId)/coupons/$(couponId)).data.revision)
                        && request.resource.data.record == get(/databases/$(database)/documents/wallets/$(walletId)/coupons/$(couponId)).data
                        && getAfter(/databases/$(database)/documents/wallets/$(walletId)/coupons/$(couponId)).data.revision == get(/databases/$(database)/documents/wallets/$(walletId)/coupons/$(couponId)).data.revision + 1;
          allow update, delete: if false;
        }
      }
    }
    match /walletInvites/{inviteId} {
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid
                    || resource.data.acceptedBy == request.auth.uid
                    || (resource.data.acceptedBy == null && resource.data.expiresAt > request.time));
      allow list: if false;
      allow create: if signedIn() && inviteId.matches('^[a-f0-9]{64}$')
                    && request.resource.data.keys().hasOnly(['walletId', 'ownerId', 'walletName', 'expiresAt', 'acceptedBy'])
                    && request.resource.data.ownerId == request.auth.uid
                    && get(/databases/$(database)/documents/wallets/$(request.resource.data.walletId)).data.ownerId == request.auth.uid
                    && get(/databases/$(database)/documents/wallets/$(request.resource.data.walletId)).data.memberIds.size() == 1
                    && request.resource.data.acceptedBy == null
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow update: if signedIn() && resource.data.acceptedBy == null && resource.data.expiresAt > request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy'])
                    && request.resource.data.acceptedBy == request.auth.uid
                    && request.auth.uid != resource.data.ownerId
                    && get(/databases/$(database)/documents/wallets/$(resource.data.walletId)).data.inviteHash == inviteId
                    && request.auth.uid in getAfter(/databases/$(database)/documents/wallets/$(resource.data.walletId)).data.memberIds;
      allow delete: if false;
    }
    match /users/{userId}/couponKeys/{key} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /coupons/{couponId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      // Removal is reversible; clients cannot permanently erase recovery history.
      allow delete: if false;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.revision == resource.data.get('revision', 0) + 1
                    && getAfter(/databases/$(database)/documents/coupons/$(couponId)/history/$(string(resource.data.get('revision', 0)))).data.record == resource.data;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      match /history/{version} {
        allow read: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/coupons/$(couponId)).data.userId;
        allow create: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/coupons/$(couponId)).data.userId
                      && request.resource.data.userId == request.auth.uid
                      && version == string(get(/databases/$(database)/documents/coupons/$(couponId)).data.get('revision', 0))
                      && request.resource.data.record == get(/databases/$(database)/documents/coupons/$(couponId)).data
                      && getAfter(/databases/$(database)/documents/coupons/$(couponId)).data.revision == get(/databases/$(database)/documents/coupons/$(couponId)).data.get('revision', 0) + 1;
        allow update, delete: if false;
      }
    }
  }
}
